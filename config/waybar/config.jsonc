// =====================================================
// WAYBAR - TOKYO NIGHT
// =====================================================
// Os ícones usam escapes \uXXXX (Nerd Font), então o arquivo
// funciona mesmo se o editor não mostrar os glifos.

{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": ["custom/arch", "hyprland/workspaces"],

    "modules-center": ["clock"],

    "modules-right": [
        "pulseaudio",
        "pulseaudio#mic",
        "network",
        "cpu",
        "custom/gpu",
        "memory",
        "backlight",
        "group/power"
    ],


    // ---------------------------------------------------
    // ESQUERDA
    // ---------------------------------------------------

    "custom/arch": {
        "format": "\uf303",
        "tooltip": false
    },


    // ---------------------------------------------------
    // ESQUERDA / WORKSPACES
    // ---------------------------------------------------
    // Sem "persistent-workspaces": só aparecem as que têm janelas
    // (a ativa de cada monitor sempre aparece, mesmo vazia)

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "disable-click": false,
        "all-outputs": true,
        "show-special": false,
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },


    // ---------------------------------------------------
    // CENTRO
    // ---------------------------------------------------

    // Clique alterna entre hora e data
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d de %B de %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },


    // ---------------------------------------------------
    // DIREITA
    // ---------------------------------------------------

    // Volume: scroll ajusta, clique muta
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf026 mudo",
        "format-icons": {
            "headphone": "\uf025",
            "default": ["\uf027", "\uf028"]
        },
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip-format": "{desc}"
    },

    // Microfone: scroll ajusta, clique muta
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-muted": "{format_source}",
        "format-source": "\uf130 {volume}%",
        "format-source-muted": "\uf131 mudo",
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",
        "tooltip": false
    },

    // IP local
    "network": {
        "interval": 5,
        "format-wifi": "\uf1eb {ipaddr}",
        "format-ethernet": "\uf0e8 {ipaddr}",
        "format-linked": "\uf0e8 sem IP",
        "format-disconnected": "\uf127 offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} via {gwaddr}",
        "tooltip-format-ethernet": "{ifname} via {gwaddr}"
    },

    "cpu": {
        "interval": 2,
        "format": "\uf2db {usage}%"
    },

    // GPU sem script externo: tenta NVIDIA e cai para AMD
    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null || cat /sys/class/drm/card*/device/gpu_busy_percent 2>/dev/null | head -n1",
        "format": "\uf26c {}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "interval": 5,
        "format": "\uf1c0 {percentage}%",
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB"
    },

    // Brilho: scroll nativo do Waybar (sem brightnessctl)
    "backlight": {
        "format": "\uf185 {percent}%",
        "scroll-step": 5,
        "min-brightness": 1,
        "tooltip": false
    },

    // Bateria + modo de energia no mesmo bloco
    "group/power": {
        "orientation": "horizontal",
        "modules": ["battery", "power-profiles-daemon"]
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "\uf0e7 {capacity}%",
        "format-plugged": "\uf1e6 {capacity}%",
        "format-full": "\uf240 {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
        "tooltip-format": "{timeTo}"
    },

    // Clique alterna entre performance / balanced / power-saver
    "power-profiles-daemon": {
        "format": "{icon} {profile}",
        "tooltip-format": "Perfil: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "\uf0e7",
            "performance": "\uf135",
            "balanced": "\uf24e",
            "power-saver": "\uf06c"
        }
    }
}
