{
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/logo/kaguya1.png",
    "width": 30,
    "height": 15,
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "custom",
      "format": "─────────────────────────────────────────"
    },
    {
      "type": "title",
      "key": "  󰣇",
      "format": "{8}"
    },
    {
      "type": "chassis",
      "key": "  󰇺 Chassis",
      "format": "{1} {2} {3}"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "format": "{1}x{2} @ {3}Hz [{7}]",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "  󱗃 WM",
      "format": "{2}",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "─────────────────────────────────────────"
    },
    {
      "type": "cpu",
      "format": "{1} @ {7}",
      "key": "   CPU",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "format": "{2} {1}",
      "key": "  󰢮 GPU",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "   RAM",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "key": "  󰋊 Disk",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "─────────────────────────────────────────"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break",
    "break"
  ]
}
